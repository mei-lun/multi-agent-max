{
  "name": "multi-agent-max",
  "version": "0.1.0",
  "private": true,
  "description": "Git-driven multi-agent workflow control plane",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "pnpm build:core && pnpm build:desktop",
    "build:core": "tsc -p tsconfig.build.json",
    "build:desktop": "electron-vite build",
    "build:mac": "pnpm package:mac",
    "build:win": "pnpm package:win",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "format": "oxfmt --write src config package.json tsconfig.json tsconfig.build.json vitest.config.ts vitest.smoke.config.ts electron.vite.config.ts migration/source-selection.json",
    "format:check": "oxfmt --check src config package.json tsconfig.json tsconfig.build.json vitest.config.ts vitest.smoke.config.ts electron.vite.config.ts migration/source-selection.json",
    "lint": "oxlint src config",
    "manifest:source": "node config/scripts/generate-source-manifest.mjs",
    "package:mac": "sh config/scripts/package-mac.sh",
    "package:win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File config/scripts/package-windows.ps1",
    "probe:executors": "node config/scripts/probe-executor-interfaces.mjs",
    "smoke:codex": "vitest run --config vitest.smoke.config.ts",
    "smoke:desktop": "node config/scripts/run-desktop-smoke.mjs",
    "smoke:desktop:seeded": "pnpm build:desktop && vitest run --config vitest.smoke.config.ts src/main/desktop-seeded-project.smoke.ts",
    "smoke:pi": "vitest run src/main/mam/executors/pi-rpc-real-process.test.ts",
    "test": "vitest run && node --test config/scripts/desktop-package-scripts.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify:final": "node config/scripts/verify-final-traceability.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.81.1",
    "@fontsource-variable/geist": "5.3.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@radix-ui/react-dialog": "1.1.21",
    "@radix-ui/react-select": "2.3.5",
    "@radix-ui/react-slot": "^1.3.2",
    "@radix-ui/react-tooltip": "^1.2.15",
    "@xyflow/react": "12.11.2",
    "ajv": "8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.26.0",
    "minimatch": "10.2.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "yaml": "2.8.4",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@swc/core": "^1.15.46",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "25.6.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "oxfmt": "0.52.0",
    "oxlint": "1.71.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": ">=22.22"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "electron",
      "esbuild"
    ]
  },
  "build": {
    "appId": "com.multiagentmax.desktop",
    "productName": "Multi-Agent Max",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "artifactName": "Multi-Agent-Max-${version}-mac-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "artifactName": "Multi-Agent-Max-${version}-windows-${arch}.${ext}",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false,
      "perMachine": false
    }
  }
}
